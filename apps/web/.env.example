# Appwrite Cloud configuration
# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git and must never be committed.

VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=bag-of-rice

# Public application URL used for verification and password reset callbacks.
# In production this MUST be an HTTPS URL (e.g. https://bag-of-rice.pages.dev).
# Set this in your hosting provider's environment variables (Cloudflare Pages, etc.).
# In development, localhost HTTP is permitted (e.g. http://localhost:5173).
VITE_APP_URL=http://localhost:5173
